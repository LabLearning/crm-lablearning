# ============================================================
# FormaCRM — Variables d'environnement
# ============================================================
# Copiez ce fichier en .env.local et renseignez les valeurs
# cp .env.local.example .env.local
# ============================================================

# ─── Supabase ───
# Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Application ───
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=FormaCRM

# ─── Resend (emails transactionnels) ───
# https://resend.com/api-keys
# En dev, les emails sont loggés en console si cette clé est absente
RESEND_API_KEY=

# ─── Stripe (facturation en ligne) — Phase 2 ───
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ─── WhatsApp (Meta Cloud API) ───
# Sans ces variables : mode DEV (les messages sont loggés, pas envoyés).
# 1. Créer une app + numéro WhatsApp Business dans Meta Business Manager
# 2. Faire approuver les templates (ex: "convocation_j3", langue fr)
# 3. Générer un token permanent (System User)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0

# ─── Coffre OPCO (mots de passe des portails OPCO, chiffrés en base) ───
# Recommandé en production : `openssl rand -hex 32`. Sans cette clé, le coffre
# dérive sa clé de SUPABASE_SERVICE_ROLE_KEY. Pour changer de clé : poser la
# nouvelle dans OPCO_SECRET_KEY, l'ancienne dans OPCO_SECRET_KEY_PREVIOUS
# (virgules entre plusieurs), déployer ; chaque mot de passe est re-chiffré
# à sa prochaine lecture. Même logique avec SUPABASE_SERVICE_ROLE_KEY_PREVIOUS
# si la clé de service Supabase est renouvelée.
OPCO_SECRET_KEY=
OPCO_SECRET_KEY_PREVIOUS=
